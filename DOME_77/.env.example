BOT_TOKEN=
OPENAI_API_KEY=
# Recommended on Railway with a Volume mounted at /data:
DATA_DIR=/data
STORAGE_ROOT=/data
DATABASE_URL=sqlite+aiosqlite:////data/app.db
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
CHILD_TTS_VOICE=shimmer
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
WEBAPP_BASE_URL=
WEBAPP_PORT=8080
MOBILE_AUTH_SECRET=
# Railway blocks outbound SMTP on Free/Trial/Hobby plans. Production email uses
# the existing verified BilingvaDom domain through Resend's HTTPS API.
EMAIL_DELIVERY_PROVIDER=resend
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
MAIL_FROM="Bilingvadom <no-reply@bilinguadom.com>"
EMAIL_API_TIMEOUT_SECONDS=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=DOME
SMTP_STARTTLS=true

PAYMENT_URL=
PAYMENT_URL_TRIAL=
PAYMENT_URL_GROUP=
PAYMENT_URL_INDIVIDUAL=

# SMSCenter Georgia (dashboard.smscenter.ge)
# Create an API key and an approved sender name in the dashboard.
SMSCENTER_API_KEY=
SMSCENTER_SENDER_ID=DOME
SMSCENTER_API_URL=https://sms-api.wifisher.com/api/v2/send
SMS_OTP_TTL_SECONDS=600
SMS_OTP_MAX_ATTEMPTS=5
SMS_OTP_RESEND_COOLDOWN_SECONDS=60

# Long random secret, at least 24 characters. Never share it.
CONSENT_HASH_SECRET=replace-with-a-long-random-secret-at-least-24-characters
VOICE_CONSENT_VERSION=2026-08-05-v2
PAYMENT_CONSENT_VERSION=2026-08-05-v2

# Railway injects this automatically after Settings → Networking → Generate Domain
RAILWAY_PUBLIC_DOMAIN=
SMS_BYPASS=true

# Public HTTPS URL generated in Railway Networking, without a trailing slash.
# Example: https://dome-telegram-bot-production.up.railway.app

# Temporary development-only SMS bypass. Set false before production.

# Admins allowed to use /activity, comma-separated Telegram numeric IDs.
ADMIN_TELEGRAM_IDS=

# Future optional integrations. Leave empty until enabled.
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
OBJECT_STORAGE_URL=
OBJECT_STORAGE_KEY=
OBJECT_STORAGE_SECRET=
VISION_PROVIDER=
VISION_API_KEY=


# Support / parent communication
SUPPORT_CHAT_URL=
SUPPORT_CALL_LABEL=+995000000000

# Optional birthday / notifications
EMAIL_REPORTS_DEFAULT=true

# Optional full-body animation (Kling AI). Leave empty to keep the current stable PNG animation.
KLING_API_KEY=
KLING_API_SECRET=
KLING_API_BASE=https://api-singapore.klingai.com
KLING_MODEL_NAME=kling-v1-6
KLING_MODE=std
CHARACTER_AI_ANIMATION=auto
CHARACTER_ANIMATION_MAX_RETRIES=2
CHARACTER_ANIMATION_QC=true

# v52 optional full-body animation
# v67: persistent Railway volume. Mount volume at /data and use:
# STORAGE_ROOT=/data
# Admin Telegram user IDs (comma-separated) for /addlesson, /dome_price, /dome_billing:
# ADMIN_TELEGRAM_IDS=123456789
# DATABASE_URL=sqlite+aiosqlite:////data/app.db

# Optional future paid mode; not required during free testing.
PAYMENT_PROVIDER=custom
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# When ready: set provider=stripe in persistent payment settings and /dome_billing on.


# =============================
# DOME v71 PRODUCTION PAYMENTS
# =============================
# Choose at runtime with admin command: /dome_provider stripe | unipay
# Then /dome_billing on performs credential safety checks and disables test bypasses.
PAYMENT_PROVIDER=custom
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# UniPAY (Georgia) merchant API V3. Copy exact endpoint/credentials from your approved merchant account.
# DOME never receives/stores PAN/CVV.
UNIPAY_SUBSCRIPTION_URL=
UNIPAY_SUBSCRIPTION_UPDATE_URL=
UNIPAY_ACCESS_TOKEN=
UNIPAY_MERCHANT_ID=
UNIPAY_API_KEY=
# Configure ONE of the following according to the merchant webhook configuration:
UNIPAY_WEBHOOK_SECRET=
UNIPAY_WEBHOOK_TOKEN=

# Public callback for UniPAY: https://YOUR-RAILWAY-DOMAIN/webhooks/unipay
# Stripe callback: https://YOUR-RAILWAY-DOMAIN/webhooks/stripe

# Unlimit (official Payment Page + recurring/subscriptions)
UNLIMIT_TOKEN_URL=
UNLIMIT_PAYMENT_URL=
UNLIMIT_RECURRING_URL=
UNLIMIT_RECURRING_UPDATE_URL=
UNLIMIT_API_TOKEN=
UNLIMIT_TERMINAL_CODE=
UNLIMIT_PASSWORD=
UNLIMIT_CALLBACK_SECRET=
UNLIMIT_SIGNATURE_HEADER=X-Signature
# Callback: https://YOUR-RAILWAY-DOMAIN/webhooks/unlimit

# PayPal Subscriptions
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PRODUCT_ID=
# Webhook: https://YOUR-RAILWAY-DOMAIN/webhooks/paypal
