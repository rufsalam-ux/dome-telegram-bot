        "Мила подарила",
        "Мила привезла",
        "мишку",
        "книгу",
        "букет",
        "рюкзак"
      ]
    },
    {
      "phrase_id": "take_trip",
      "target_text": "Я возьму с собой...",
      "native_hint": "Выбери предмет на новом слайде и скажи коротко: «Я возьму с собой…». Например: куртку, бинокль, фотоаппарат, компас или блокнот.",
      "choices": [
        "куртку",
        "бинокль",
        "бутылку воды",
        "компас",
        "мишку",
