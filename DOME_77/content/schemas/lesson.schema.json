{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dome.school/schemas/lesson.schema.json",
  "title": "DOME content_v1 lesson",
  "type": "object",
  "required": ["engine", "schema_version", "lesson_id", "course_id", "title", "order", "status"],
  "anyOf": [
    {"required": ["slides"]},
    {"required": ["steps"]}
  ],
  "properties": {
    "engine": {"const": "content_v1"},
    "schema_version": {"type": "string", "minLength": 1},
    "lesson_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$"},
    "course_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "order": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "published", "archived"]},
    "active": {"type": "boolean"},
    "max_completed_runs": {"const": 2},
    "expires_after_months": {"const": 10},
    "languages": {
      "type": "object",
      "required": ["target", "native"],
      "properties": {
        "target": {"type": "string", "pattern": "^[a-zA-Z]{2,3}$"},
        "native": {"type": "string", "pattern": "^[a-zA-Z]{2,3}$"}
      },
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/slide"}
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/slide"}
    }
  },
  "$defs": {
    "media": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["image", "video", "animation", "youtube", "audio"]},
        "src": {"type": "string"},
        "url": {"type": "string"},
        "animation_id": {"type": "string"},
        "autoplay": {"type": "boolean"},
        "auto_continue": {"type": "boolean"},
        "advance_on_end": {"type": "boolean"},
        "skippable": {"type": "boolean"},
        "replay": {"type": "boolean"},
        "poster": {"type": "string"},
        "aspect_ratio": {"type": ["number", "string"]}
      },
      "additionalProperties": true
    },
    "slide": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "slide_id": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 1},
        "type": {"enum": ["slide", "video", "ai_dialogue", "voice_answer", "choice", "drag_drop", "animal_description", "break", "activity", "guided_speaking", "presentation", "card_selector", "choice_card", "guided_scene", "transition", "drag_and_drop", "animal_compare", "animal_riddle", "personal_travel_story"]},
        "src": {"type": "string"},
        "autoplay": {"type": "boolean"},
        "autoContinue": {"type": "boolean"},
        "auto_continue": {"type": "boolean"},
        "skippable": {"type": "boolean"},
        "replay": {"type": "boolean"},
        "poster": {"type": "string"},
        "aspect_ratio": {"type": ["number", "string"]},
        "target_phrase": {"type": "string"},
        "native_explanation": {"type": "string"},
        "ai_instruction": {"type": "string"},
        "next_step_id": {"type": "string"},
        "controls": {
          "type": "object",
          "properties": {
            "answer": {"type": "object"},
            "continue": {"type": "object"},
            "hint": {"type": "object"},
            "follow_up": {"type": "object"}
          },
          "additionalProperties": true
        },
        "media_sequence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/media"}
        },
        "protected_zones": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {"type": "number", "minimum": 0, "maximum": 1},
              {"type": "number", "minimum": 0, "maximum": 1},
              {"type": "number", "minimum": 0, "maximum": 1},
              {"type": "number", "minimum": 0, "maximum": 1}
            ],
            "minItems": 4,
            "maxItems": 4
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
