{
  "schema_version": "1.0",
  "first_child_scene_seconds": 10,
  "target_duration_seconds": [
    60,
    90
  ],
  "motion": {
    "walk": true,
    "body_bob": true,
    "gesture_motion": true,
    "mouth_flap": true,
    "limb_rig_mode": "segmented_assets_when_available"
  },
  "companions": {
    "enabled": true,
    "min": 1,
    "max": 3,
    "dialogue_scenes_min": 2,
    "dialogue_scenes_max": 4,
    "catalog_ids": [
      "fox",
      "robot",
      "cat",
      "dragon",
      "star",
      "explorer"
    ]
  },
  "credits_enabled": true,
  "motion_cache_enabled": true,
  "motion_library_mode": "reuse_before_generate",
  "timeline_instruction_enabled": true,
  "lip_sync_requested": true,
  "segmented_character_required_for_full_limb_animation": true,
  "first_child_scene_rule": "stay_visible_until_scene_dialogue_finishes",
  "credit_seconds": 3,
  "credit_safe_area": true,
  "generate_missing_animation_during_render": false,
  "ffmpeg_timeout_seconds": 75,
  "total_render_timeout_seconds": 90,
  "render_wait_policy": "cached_animation_or_png_then_base_video_fallback",
  "preserve_original_child_audio": true,
  "rewrite_child_words": false,
  "telegram_video_max_bytes": 45000000,
  "telegram_transcode_timeout_seconds": 90,
  "telegram_send_timeout_seconds": 120
}