# Keep EAS preview uploads limited to build source and declared assets.
# EAS resolves this ignore file from the mobile project, but archives from the
# monorepo Git root.  These root-relative exclusions keep server code, Git
# history and local build products out of the Android source upload.
/.git/
/.github/
/.pytest_tmp/
/DOME_77/
/content/
/storage/
/scratch_*.png
/Dockerfile
/railway.json
/codemagic.yaml
/DOME_MOBILE_77/node_modules/
/DOME_MOBILE_77/.expo/
/DOME_MOBILE_77/.npm-cache/
/DOME_MOBILE_77/graphify-out/
/DOME_MOBILE_77/android/.gradle/
/DOME_MOBILE_77/android/.kotlin/
/DOME_MOBILE_77/android/.cxx/
/DOME_MOBILE_77/android/build/
/DOME_MOBILE_77/android/app/build/
/DOME_MOBILE_77/android/app/dome-release.keystore
/DOME_MOBILE_77/android/app/*.keystore
/DOME_MOBILE_77/*.apk
/DOME_MOBILE_77/*.aab

node_modules/
.expo/
.npm-cache/
graphify-out/
dist/
.env
.env.*
!.env.example
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
*.pem

# Local diagnostics, previous Expo bundles/QRs, and one-off image work are
# never part of an installable tester APK.
.expo-*
.runtime-*/
expo_*.png
scratch_*.png
temp_*.png
*_files.txt
all_*.txt
ascii_qr.txt
cat_stickers.txt
chatgpt_*.txt
detali_files.txt
downloads_all_folders.txt
inverted_qr.txt
qr_display.txt
tg_*.txt
unicode_qr.txt
*.zip
*.apk
*.aab

# Pytest temp dirs (cause EPERM on Windows/OneDrive during EAS upload)
../.pytest-*/
.pytest-*/
../.pytest-tmp-*/
../.pytest-progress-*/

# Gradle build cache & local build artifacts
android/.cxx/
android/app/build/
android/build/
android/.gradle/
android/app/src/main/assets/index.android.bundle

# Local keystore (never upload — EAS uses remote credentials)
android/app/dome-release.keystore
android/app/*.keystore
