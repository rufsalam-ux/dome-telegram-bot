# Keep EAS preview uploads limited to build source and declared assets.
node_modules/
.expo/
.npm-cache/
graphify-out/
dist/
.env
.env.*
!.env.example
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
*.pem

# Local diagnostics, previous Expo bundles/QRs, and one-off image work are
# never part of an installable tester APK.
.expo-*
.runtime-*/
expo_*.png
scratch_*.png
temp_*.png
*_files.txt
all_*.txt
ascii_qr.txt
cat_stickers.txt
chatgpt_*.txt
detali_files.txt
downloads_all_folders.txt
inverted_qr.txt
qr_display.txt
tg_*.txt
unicode_qr.txt
*.zip

# Pytest temp dirs (cause EPERM on Windows/OneDrive during EAS upload)
../.pytest-*/
.pytest-*/
../.pytest-tmp-*/
../.pytest-progress-*/

# Large video assets are served from Railway CDN at runtime — exclude from APK archive
assets/videos/*.mov
assets/videos/*.mp4
assets/videos/*.avi

# Gradle build cache & local build artifacts
android/.cxx/
android/app/build/
android/build/
android/.gradle/
android/app/src/main/assets/index.android.bundle
android/app/src/main/res/drawable/
android/app/src/main/res/raw/

# Local keystore (never upload — EAS uses remote credentials)
android/app/dome-release.keystore
android/app/*.keystore
