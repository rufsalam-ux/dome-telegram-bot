{
  "name": "dome-mobile",
  "version": "3.1.2",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "check": "tsc --noEmit",
    "test:runtime": "node --experimental-strip-types --test tests/lessonRuntime.test.ts",
    "validate-lessons": "node scripts/validate-lessons.mjs",
    "build:apk": "eas build -p android --profile preview",
    "build:android-store": "eas build -p android --profile production",
    "build:ios-store": "eas build -p ios --profile production",
    "install:mobile": "npx expo install expo-av expo-speech expo-image-picker"
  },
  "dependencies": {
    "expo": "^57.0.17",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-file-system": "~57.0.6",
    "expo-image-picker": "~57.0.16",
    "expo-secure-store": "~57.0.3",
    "expo-speech": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3"
  }
}
